# ====================================================================
# ELEVATE — Environment variables
# Copy this file to `.env` and fill in each value.
# The SETUP_GUIDE.md explains where to get every one of these.
# ====================================================================

# --- Database (Supabase / Neon / any Postgres) ----------------------
# Get this from your database provider's connection settings.
DATABASE_URL="postgresql://user:password@host:5432/elevate?schema=public"

# --- NextAuth (authentication) --------------------------------------
# NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (billing) -----------------------------------------------
# From dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price IDs for your plans (Stripe -> Products). Create Pro + Team.
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_TEAM="price_..."
# Webhook signing secret (Stripe -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Video upload (Mux — recommended for video) ---------------------
# From dashboard.mux.com -> Settings -> Access Tokens
MUX_TOKEN_ID="..."
MUX_TOKEN_SECRET="..."

# --- Analysis backend (your future computer-vision service) ---------
# Leave blank to use the built-in simulated provider.
# When your real CV service is ready, set its URL + key here.
ANALYSIS_API_URL=""
ANALYSIS_API_KEY=""

# --- App URL (used in emails / links) -------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
